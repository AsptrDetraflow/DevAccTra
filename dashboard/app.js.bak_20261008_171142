    async function generateMid() {
        const box = $("#midModalContent");
        box.innerHTML = '<div style="text-align:center;padding:24px 0;color:#69756D;font-size:.85rem"><span class="spinner-dot"></span> Mendeteksi Machine ID...</div>';
