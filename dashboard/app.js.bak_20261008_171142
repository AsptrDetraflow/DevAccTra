    function getAccounts() {
        try { return JSON.parse(localStorage.getItem(ACCOUNTS_KEY) || "{}"); }
        catch (e) { return {}; }
    }
    function saveAccounts(a) {
        try { localStorage.setItem(ACCOUNTS_KEY, JSON.stringify(a)); } catch (e) {}
